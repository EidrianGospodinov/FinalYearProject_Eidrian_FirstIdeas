  dialogueText: 
  dialogue:
  - isPlayer: 1
    text: "A map? You\u2019re giving me a map after all those questions?!"
  - isPlayer: 1
    text: I spent forty minutes explaining my childhood fear of sourdough just for
      a piece of paper?
  - isPlayer: 1
    text: I was told this test would reveal my 'Inner Warrior,' not my 'Inner Tourist'!
  - isPlayer: 0
    text: Look, kid, the map shows where the gym is. Calm down.
  - isPlayer: 1
    text: I don't want a gym, Tony! I want destiny
