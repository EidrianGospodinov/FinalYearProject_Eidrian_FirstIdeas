  m_Script: {fileID: 11500000, guid: 539f376c48a44fc894c044893a93b560, type: 3}
  m_Name: DrinkLinearDialogue
  m_EditorClassIdentifier: 
  dialogueText: 
  dialogue:
  - isPlayer: 1
    text: I'd love to order a drink to start. What's your most unique offering?
  - isPlayer: 0
    text: We have a special house blend coffee that's roasted locally. It's got notes
      of chocolate and caramel.
  - isPlayer: 1
    text: That sounds delicious. What about tea? Do you have any exotic options?
  - isPlayer: 0
    text: We have a rose petal tea that's infused with dried rose petals and a hint
      of lemon. It's a refreshing and soothing choice.
  - isPlayer: 1
    text: That sound too fancy for me, do you have more standard options?
  - isPlayer: 0
    text: 'Of course, '
  nextNode: {fileID: 11400000, guid: cdf2fee562ac2c4449b977ed5794eb1f, type: 2}
