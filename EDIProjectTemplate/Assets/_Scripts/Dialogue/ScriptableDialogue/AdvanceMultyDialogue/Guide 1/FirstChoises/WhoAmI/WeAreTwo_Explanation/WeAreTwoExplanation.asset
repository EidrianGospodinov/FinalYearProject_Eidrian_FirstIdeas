  m_Script: {fileID: 11500000, guid: 539f376c48a44fc894c044893a93b560, type: 3}
  m_Name: WeAreTwoExplanation
  m_EditorClassIdentifier: 
  dialogueText: 
  dialogue:
  - isPlayer: 0
    text: Its a really long story.
  - isPlayer: 0
    text: I have time, nowhere else to be.
  - isPlayer: 0
    text: 'You don''t but okay. When you were young, there was accident. '
  - isPlayer: 1
    text: Where you and your friend almost died.
  - isPlayer: 0
    text: Durring that traumatic event, your bodies became one.
  - isPlayer: 1
    text: This is crazy, IMPOSSIBLE!
  - isPlayer: 0
    text: 'Its not, but for now just remember, '
  - isPlayer: 0
    text: Together you are stronger!
  - isPlayer: 0
    text: To change between each other, simple press V
  - isPlayer: 0
    text: You are children of different gods, and you have unique abilities
  - isPlayer: 1
    text: ' and you are more powerfull against different entities.'
  - isPlayer: 0
    text: Also the only way to lick your wounds during or after a battle is when
      you are not the facing hero,
  - isPlayer: 1
    text: switch and you will slowly regenerate back to full health
  - isPlayer: 0
    text: I am sorry but thats all i can say, Good luck, you are going to need it.
  - isPlayer: 1
    text: Waittttttt
  nextNode: {fileID: 11400000, guid: b34ab59262877cc4eaec0bb6615b98a3, type: 2}
